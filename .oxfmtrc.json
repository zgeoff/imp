{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "bun.lock",
    "kernel/out/**",
    ".cache/**",
    "packages/api/protocol-schema.json",
    "packages/daemon/src/db/schema.ts",
    "packages/daemon/src/agent-client/gen/**"
  ],
  "proseWrap": "always",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortImports": {
    "groups": ["side_effect", "builtin", "external", "unknown", ["parent", "sibling", "index"]],
    "newlinesBetween": false,
    "sortSideEffects": false
  }
}
