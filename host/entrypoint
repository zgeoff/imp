#!/bin/bash
# Host container entrypoint: storage, network, then impd under a small
# supervisor. Run the container with --init so orphaned processes get reaped.
#
# The supervisor restarts impd when it exits on its own. Firecracker processes
# are detached (setsid), so an impd restart keeps the VMs; impd re-adopts them.
# SIGTERM or SIGINT stops impd and ends the container.
#
# Env: IMP_DAEMON (default /src/packages/daemon/src/main.ts) is the impd entry:
#      a .ts source file runs under bun (dev), anything else is the compiled
#      impd (the release image sets /usr/local/bin/impd).
set -euo pipefail

lib=/usr/local/lib/imp
daemon=${IMP_DAEMON:-/src/packages/daemon/src/main.ts}
case $daemon in
  *.ts) run_daemon=(bun "$daemon") ;;
  *) run_daemon=("$daemon") ;;
esac

"$lib/setup-storage.sh"
"$lib/setup-net.sh"
# no-op without TAILSCALE_AUTHKEY; a tailnet failure must not keep impd down
"$lib/tailscale-up.sh" || echo "entrypoint: tailscale-up failed; continuing without the tailnet" >&2

child=
stopping=

on_signal() {
  stopping=1
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null || true
  fi
}
trap on_signal TERM INT

while [ -z "$stopping" ]; do
  "${run_daemon[@]}" &
  child=$!
  # A signal between the fork and the line above found no child to kill.
  if [ -n "$stopping" ]; then
    kill -TERM "$child" 2>/dev/null || true
  fi
  rc=0
  wait "$child" || rc=$?
  # A trapped signal interrupts wait before impd has exited.
  while kill -0 "$child" 2>/dev/null; do
    wait "$child" || rc=$?
  done
  child=
  if [ -n "$stopping" ]; then
    exit 0
  fi
  echo "entrypoint: impd exited with $rc; restarting in 1s" >&2
  sleep 1
done
