{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    // every file that tripped this needed an exemption rather than a change,
    // so the count was never the thing worth holding down
    "import/max-dependencies": "off",
    "zgeoff/function-verb": [
      "error",
      {
        // imp's domain verbs: the lifecycle an imp moves through, its disk,
        // which only grows, and its elastic memory, which also shrinks
        "verbs": ["allocate", "list", "open", "sleep", "wake", "hold", "grow", "shrink"],
        "exemptNames": [
          "main",
          // the testing skill names this narrowing helper
          "invariant",
          // kysely's Driver interface: BunSqliteDriver implements it, so
          // these method names are fixed by the library contract
          "init",
          "acquireConnection",
          "beginTransaction",
          "commitTransaction",
          "rollbackTransaction",
          "releaseConnection",
          "destroy",
          // kysely's Migration interface
          "up"
        ]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "allow": [
          // wraps a live db connection; not meaningfully freezable
          { "from": "package", "name": "Database", "package": "bun:sqlite" },
          // a zod schema: its methods build new schemas and never change it
          { "from": "package", "name": "ZodType", "package": "zod" },
          // query builders bound to a live connection; not meaningfully
          // freezable
          { "from": "package", "name": ["Kysely", "Transaction"], "package": "kysely" },
          // every field is already readonly; the type itself has no
          // readonly form to wrap it in
          { "from": "package", "name": "CompiledQuery", "package": "kysely" },
          // a kysely connection bound to a live driver; not meaningfully freezable
          { "from": "package", "name": "DatabaseConnection", "package": "kysely" },
          // kysely-codegen's introspection of the migrated database, which the
          // schema render reads to build a copy
          {
            "from": "package",
            "name": ["DatabaseMetadata", "TableMetadata", "ColumnMetadata", "EnumCollection"],
            "package": "kysely-codegen"
          },
          // a migrator result read once for its error field, never mutated
          { "from": "package", "name": "MigrationResultSet", "package": "kysely" },
          // the Kysely handle above under its schema-bound aliases
          { "from": "file", "name": ["ImpDatabase", "ImpQueries"] },
          // protobuf-es descriptors, JSON values and messages, which its API
          // types as mutable; the agent client only reads them
          {
            "from": "package",
            "name": [
              "DescMessage",
              "DescFile",
              "DescField",
              "JsonValue",
              "Message",
              "MessageInitShape"
            ],
            "package": "@bufbuild/protobuf"
          },
          // the agent protocol's generated messages, mutable for the same reason
          {
            "from": "file",
            "name": [
              "Activity",
              "ErrorData",
              "InnerStatus",
              "LogCursor",
              "Ping",
              "Previous",
              "Request",
              "Resume",
              "ResumeFrom",
              "ServiceDef",
              "ServiceStatus",
              "ServicesList",
              "SessionInfo",
              "Started"
            ],
            "path": "packages/daemon/src/agent-client/gen/imp/agent/v1/agent_pb.ts"
          },
          // a request to the agent, and a session impd saw: generated messages
          // under the names impd gives them
          {
            "from": "file",
            "name": "AgentRequest",
            "path": "packages/daemon/src/agent-client/agent-requests.ts"
          },
          {
            "from": "file",
            "name": "SeenSession",
            "path": "packages/daemon/src/sessions/session-cache.ts"
          },
          {
            "from": "file",
            "name": "ServiceDefInit",
            "path": "packages/daemon/src/agent-client/service-requests.ts"
          },
          {
            "from": "file",
            "name": "MockSessionOverrides",
            "path": "packages/daemon/src/test-utils/build-mock-agent-session.ts"
          },
          // tar-stream's live pack and extract streams, which `imp cp` drives
          { "from": "package", "name": ["Pack", "Extract", "Sink"], "package": "tar-stream" },
          // a live socket or listener; reading and writing it is the point
          { "from": "package", "name": ["Socket", "Server"], "package": "node:net" },
          // dns-packet's records carry Buffers; the resolver only reads them
          // or builds new ones
          { "from": "package", "name": ["Answer", "DecodedPacket"], "package": "dns-packet" },
          // the SSH gateway's live connections, channels and login requests,
          // ssh2's record of a client, which the gateway only reads, and the
          // client side its tests drive
          {
            "from": "package",
            "name": [
              "Connection",
              "Session",
              "ServerChannel",
              "AuthContext",
              "ClientInfo",
              "Client",
              "ClientChannel"
            ],
            "package": "ssh2"
          },
          // the MCP SDK's live server, transports and per-request context,
          // and the request and auth records it hands a handler to read
          {
            "from": "package",
            "name": [
              "Server",
              "Transport",
              "WebStandardStreamableHTTPServerTransport",
              "ServerContext",
              "CallToolRequest",
              "AuthInfo"
            ],
            "package": "@modelcontextprotocol/server"
          },
          // live streams the SSH gateway relays between
          { "from": "package", "name": ["Readable", "Writable"], "package": "node:stream" },
          { "from": "package", "name": "Buffer", "package": "@types/node" },
          // live servers, sockets and streams the proxy relays between
          { "from": "file", "name": "ProxyServer" },
          {
            "from": "package",
            "name": [
              "WebSocket",
              "ServerWebSocket",
              "MessageEvent",
              "ReadableStream",
              "Headers",
              "Request",
              "Response",
              "Blob"
            ],
            "package": "bun-types"
          },
          { "from": "lib", "name": ["WebSocket", "MessageEvent", "ReadableStream", "Headers"] },
          // an Error: its stack and message are the runtime's to set
          { "from": "file", "name": "ExecError", "path": "packages/client/src/exec/exec-error.ts" },
          // dependency bags that carry the live db handle
          { "from": "file", "name": ["RouterDeps", "AppDeps"] },
          // the dashboard's provider props carry the live SDK client
          { "from": "file", "name": "ImpdProviderProps" },
          // the dashboard's stub impd and the router's history hold live state
          { "from": "file", "name": "StubImpd" },
          { "from": "package", "name": "RouterHistory", "package": "@tanstack/history" },
          // already the readonly form, or a value type with no readonly form,
          // that the rule doesn't recognize as such
          {
            "from": "lib",
            "name": ["ReadonlySet", "ReadonlyMap", "Uint8Array", "Request", "Date", "Promise"]
          },
          // the abort signal under its Node declaration, which Bun's globals use
          { "from": "package", "name": "AbortSignal", "package": "@types/node" },
          // DOM values the dashboard reads and never changes: a form's
          // fields, an abort signal, an error, a stream reader
          {
            "from": "lib",
            "name": ["FormData", "AbortSignal", "Error", "ReadableStreamDefaultReader"]
          },
          // React's own prop types, which have no readonly form
          { "from": "package", "name": ["ReactNode", "ButtonHTMLAttributes"], "package": "react" }
        ]
      }
    ],
    // zod's documented import form is `import * as z from 'zod'`
    "import/no-namespace": "off",
    "max-statements": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-params": "off",
    "no-inline-comments": "off",
    "no-continue": "off",
    "init-declarations": "off",
    "no-await-in-loop": "off",
    "promise/avoid-new": "off",
    "require-unicode-regexp": "off"
  },
  "overrides": [
    {
      // the web dashboard: React in a browser
      "files": ["packages/dashboard/**"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
      "env": { "browser": true },
      "rules": {
        // React 19's JSX runtime needs no React in scope
        "react/react-in-jsx-scope": "off",
        "react/jsx-props-no-spreading": "off",
        "react/jsx-max-depth": "off",
        // stylesheets are imported for their side effect
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
      }
    },
    {
      // stage 1 import rules, one override per package. A later override
      // replaces an earlier one's no-restricted-imports, so each block carries
      // every pattern its files need, and type-only imports count. No pattern
      // uses a `!` negation: oxlint lets an import that one negation matches
      // past every pattern of the rule. This block covers a package that has
      // no block of its own yet: only db and test support build queries, so
      // every other module goes through db's repositories
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              }
            ]
          }
        ]
      }
    },
    {
      // the platform helpers: imports no @imp/* package
      "files": ["packages/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": ["node:*"],
                "message": "Keep this package runtime-neutral: no node: import in @imp/shared, @imp/api or the client."
              },
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": [
                  "@imp/local-tar",
                  "@imp/local-tar/**",
                  "@imp/api",
                  "@imp/api/**",
                  "@zgeoff/imp-client",
                  "@zgeoff/imp-client/**",
                  "@imp/mcp",
                  "@imp/mcp/**",
                  "@imp/cli",
                  "@imp/cli/**",
                  "@imp/daemon",
                  "@imp/daemon/**",
                  "@imp/dashboard",
                  "@imp/dashboard/**"
                ],
                "message": "@imp/shared imports no @imp/* package."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // a leaf: imports only @imp/shared
      "files": ["packages/local-tar/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": [
                  "@imp/api",
                  "@imp/api/**",
                  "@zgeoff/imp-client",
                  "@zgeoff/imp-client/**",
                  "@imp/mcp",
                  "@imp/mcp/**",
                  "@imp/cli",
                  "@imp/cli/**",
                  "@imp/daemon",
                  "@imp/daemon/**",
                  "@imp/dashboard",
                  "@imp/dashboard/**"
                ],
                "message": "@imp/local-tar is a leaf: it may import only @imp/shared."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // the contract: imports only @imp/shared
      "files": ["packages/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": ["node:*"],
                "message": "Keep this package runtime-neutral: no node: import in @imp/shared, @imp/api or the client."
              },
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": [
                  "@imp/local-tar",
                  "@imp/local-tar/**",
                  "@zgeoff/imp-client",
                  "@zgeoff/imp-client/**",
                  "@imp/mcp",
                  "@imp/mcp/**",
                  "@imp/cli",
                  "@imp/cli/**",
                  "@imp/daemon",
                  "@imp/daemon/**",
                  "@imp/dashboard",
                  "@imp/dashboard/**"
                ],
                "message": "@imp/api may import only @imp/shared."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // the published client: imports only @imp/shared and @imp/api
      "files": ["packages/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": ["node:*"],
                "message": "Keep this package runtime-neutral: no node: import in @imp/shared, @imp/api or the client."
              },
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": [
                  "@imp/local-tar",
                  "@imp/local-tar/**",
                  "@imp/mcp",
                  "@imp/mcp/**",
                  "@imp/cli",
                  "@imp/cli/**",
                  "@imp/daemon",
                  "@imp/daemon/**",
                  "@imp/dashboard",
                  "@imp/dashboard/**"
                ],
                "message": "The client may import only @imp/shared and @imp/api."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // the MCP server: imports the leaves, @imp/api and the client
      "files": ["packages/mcp/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": [
                  "@imp/cli",
                  "@imp/cli/**",
                  "@imp/daemon",
                  "@imp/daemon/**",
                  "@imp/dashboard",
                  "@imp/dashboard/**"
                ],
                "message": "@imp/mcp may import only @imp/shared, @imp/local-tar, @imp/api and the client."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // an app: imports every package below it, never another app
      "files": ["packages/cli/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": ["@imp/daemon", "@imp/daemon/**", "@imp/dashboard", "@imp/dashboard/**"],
                "message": "@imp/cli is an app: it may import @imp/shared, @imp/local-tar, @imp/api, the client and @imp/mcp, never another app."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // an app: imports every package below it, never another app
      "files": ["packages/daemon/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": ["@imp/cli", "@imp/cli/**", "@imp/dashboard", "@imp/dashboard/**"],
                "message": "@imp/daemon is an app: it may import @imp/shared, @imp/local-tar, @imp/api, the client and @imp/mcp, never another app."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // an app: imports every package below it, never another app
      "files": ["packages/dashboard/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": ["@imp/cli", "@imp/cli/**", "@imp/daemon", "@imp/daemon/**"],
                "message": "@imp/dashboard is an app: it may import @imp/shared, @imp/local-tar, @imp/api, the client and @imp/mcp, never another app."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // the database folder: the daemon's rules, with Kysely allowed
      "files": ["packages/daemon/src/db/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@imp/test-utils",
                  "@imp/test-utils/**",
                  "**/test-utils",
                  "**/test-utils/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/smoke",
                  "**/smoke/**"
                ],
                "message": "Production code never imports test support."
              },
              {
                "group": ["@imp/cli", "@imp/cli/**", "@imp/dashboard", "@imp/dashboard/**"],
                "message": "@imp/daemon is an app: it may import @imp/shared, @imp/local-tar, @imp/api, the client and @imp/mcp, never another app."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // test support: tests may boot impd and reach any package's helpers, so only the Kysely rule holds
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.e2e.ts",
        "**/*.pebble.ts",
        "**/test-utils/**",
        "**/smoke/**",
        "**/mocks/**",
        "packages/dashboard/e2e/**",
        "**/test-setup.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              }
            ]
          }
        ]
      }
    },
    {
      // the shared test helpers: a leaf, like @imp/local-tar
      "files": ["packages/test-utils/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["kysely", "kysely/*", "kysely-codegen"],
                "message": "Query through a repository in packages/daemon/src/db instead."
              },
              {
                "group": [
                  "@imp/local-tar",
                  "@imp/local-tar/**",
                  "@imp/api",
                  "@imp/api/**",
                  "@zgeoff/imp-client",
                  "@zgeoff/imp-client/**",
                  "@imp/mcp",
                  "@imp/mcp/**",
                  "@imp/cli",
                  "@imp/cli/**",
                  "@imp/daemon",
                  "@imp/daemon/**",
                  "@imp/dashboard",
                  "@imp/dashboard/**"
                ],
                "message": "@imp/test-utils is a leaf: it may import only @imp/shared."
              },
              {
                "regex": "^(\\.\\./)+(api|cli|client|daemon|dashboard|local-tar|mcp|shared|test-utils)/(src|smoke)(/|$)",
                "message": "Import another package by its package name, never by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      // the daemon's own test helpers build queries against real databases
      "files": ["packages/daemon/src/test-utils/**", "packages/daemon/src/db/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  // .claude/** holds the skill-gate hook, which repo-sync delivers from
  // zgeoff/tools: a fix lands upstream, never here
  "ignorePatterns": [
    ".claude/**",
    ".cache/**",
    "kernel/**",
    "agent/**",
    // protoc-gen-es output (bun run gen:proto)
    "packages/daemon/src/agent-client/gen/**"
  ]
}
