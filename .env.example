# Tailscale auth key: reusable, ephemeral, tagged (e.g. tag:imp). scripts/dev.sh
# takes TAILSCALE_AUTHKEY from the env first, then (with IMP_TAILSCALE_OP=1) from
# 1Password with `op read "$IMP_TAILSCALE_AUTHKEY_REF"` (default
# op://cloud/imp-tailscale-authkey/credential; 20 s limit), and only then from
# this file.
TAILSCALE_AUTHKEY=
