exports[`it prints the help of impz set as it always has 1`] = `
"Change an imp's CPU limit or weight (at once when running), its vCPUs (stopped only), or its HTTP port (impz set v2.4.1)

USAGE impz set [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)

OPTIONS

    --cpu-limit=<cpu_limit>    cores the VM may use, such as 1.5, or none (default none)   
  --cpu-weight=<cpu_weight>    share of the host under contention, 1 to 10000 (default 100)
              --cpus=<cpus>    vCPU count; the imp must be stopped                         
    --http-port=<http_port>    the port the imp's URL reaches                              
                     --json    print JSON                                                  


"
`;

exports[`it prints the help of impz top as it always has 1`] = `
"Watch every imp's CPU, memory and traffic (impz top v2.4.1)

USAGE impz top [OPTIONS] 

OPTIONS

  --once    print the table once and exit
  --json    print JSON                   


"
`;

exports[`it prints the help of impz url as it always has 1`] = `
"Print an imp's URLs: https first when HTTPS is on, then its tailnet name, local and tailnet (impz url v2.4.1)

USAGE impz url [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)


"
`;

exports[`it prints the help of impz proxy as it always has 1`] = `
"Forward local ports to ports in an imp, waking it on connect (impz proxy <name> 5432 3001:3000), or with --reverse, a socket or port in the imp to this machine (impz proxy v2.4.1)

USAGE impz proxy [OPTIONS] <NAME> [PORTS]

ARGUMENTS

   NAME    imp name (Required)                                 
  PORTS    port, or local:remote; a local 0 takes any free port

OPTIONS

  --reverse=<reverse>    GUEST:LOCAL, each an absolute socket path or a port, to relay clients in the imp to this machine; repeatable. The first listen wakes the imp. After a sleep the forward waits for something else to wake the imp, never waking it, then listens again; if its listener ended while the imp stayed awake, it listens again after 30 s


"
`;

exports[`it prints the help of impz cp as it always has 1`] = `
"Copy a file or directory into or out of an imp (impz cp ./dir box:/srv/dir, impz cp box:/var/log/x .) (impz cp v2.4.1)

USAGE impz cp [OPTIONS] <SOURCE> <TARGET>

ARGUMENTS

  SOURCE    a local path, or NAME:PATH in an imp (Required)
  TARGET    a local path, or NAME:PATH in an imp (Required)

OPTIONS

  --owner=<owner>    owner of what a copy into an imp makes: user, uid, user:group (default: the owner of the directory it lands in)


"
`;

exports[`it prints the help of impz policy as it always has 1`] = `
"Show or set an imp's egress policy: open, public, box with --allow, or none (impz policy v2.4.1)

USAGE impz policy [OPTIONS] <NAME> [MODE]

ARGUMENTS

  NAME    imp name (Required)      
  MODE    open, public, box or none

OPTIONS

  --allow=<allow>    what a box may reach: hosts, *.domains, IP addresses or CIDRs, comma-separated
           --json    print JSON                                                                    


"
`;

exports[`it prints the help of impz expose as it always has 1`] = `
"Serve an imp to the internet at https://<name>.<domain>, with optional auth (impz expose v2.4.1)

USAGE impz expose [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)

OPTIONS

  --auth=<auth>    what the imp asks for before it wakes: token (default), basic or none
  --user=<user>    the basic auth user (default imp)                                    
         --json    print JSON                                                           


"
`;

exports[`it prints the help of impz unexpose as it always has 1`] = `
"Take an imp off the internet: tailnet only again (impz unexpose v2.4.1)

USAGE impz unexpose [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz net as it always has 1`] = `
"Manage private networks between imps (impz net v2.4.1)

USAGE impz net create|ls|rm|join|leave

COMMANDS

  create    Create a private network for imps                                        
      ls    List networks and the imps on each                                       
      rm    Delete a network; its imps' connections to each other end                
    join    Put an imp on a network: it reaches the network's other imps, and they it
   leave    Take an imp off a network; its connections to the network's imps end     

Use impz net <command> --help for more information about a command.

"
`;

exports[`it prints the help of impz net create as it always has 1`] = `
"Create a private network for imps (net create)

USAGE net create [OPTIONS] <NETWORK>

ARGUMENTS

  NETWORK    network name (Required)

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz net ls as it always has 1`] = `
"List networks and the imps on each (net ls)

USAGE net ls [OPTIONS] 

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz net rm as it always has 1`] = `
