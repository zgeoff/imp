USAGE net join [OPTIONS] <NETWORK> <NAME>

ARGUMENTS

  NETWORK    network name (Required)
     NAME    imp name (Required)    

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz net leave as it always has 1`] = `
