exports[`it prints the help of impz exec as it always has 1`] = `
"Run a command in an imp (impz exec [-t] <name> -- cmd args) (impz exec v2.4.1)

USAGE impz exec [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)

OPTIONS

            -t, --tty    run on a terminal                                                                                 
              --agent    run as root in the imp's agent, outside its container, with busybox (host-wide manage scope)      
  --require=<require>    start the command only if impd can ensure these, or fail and run nothing: broker (comma-separated)


"
`;

exports[`it prints the help of impz console as it always has 1`] = `
"Open a shell in an imp, in a session that outlives the terminal (ctrl-] detaches) (impz console v2.4.1)

USAGE impz console [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)

OPTIONS

        --session=<session>    session to start or attach to (default main on a terminal); --no-session for a shell that ends with the terminal
                      --log    impd keeps the output of the session this starts, for impz sessions log (docs/guides/session-logs.md)           
  --detach-key=<detach_key>    key that detaches from the session: ctrl-<key>, or none (Default: ctrl-])                                       


"
`;

exports[`it prints the help of impz attach as it always has 1`] = `
"Attach to a session in an imp: its recent output, then live (ctrl-] detaches) (impz attach v2.4.1)

USAGE impz attach [OPTIONS] <NAME> [SESSION]

ARGUMENTS

     NAME    imp name (Required)        
  SESSION    session name (default main)

OPTIONS

  --detach-key=<detach_key>    key that detaches from the session: ctrl-<key>, or none (Default: ctrl-])


"
`;

exports[`it prints the help of impz sessions as it always has 1`] = `
"List an imp's sessions without waking it (impz sessions kill <name> <session> ends one; logs, log and log-rm read and delete session logs) (impz sessions v2.4.1)

USAGE impz sessions [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)

OPTIONS

         --json    print JSON                                            
  --from=<from>    impz sessions log: the offset to read from (default 0)


"
`;

exports[`it prints the help of impz service as it always has 1`] = `
"Manage an imp's services: add, ls, rm, restart (impz service v2.4.1)

USAGE impz service add|ls|rm|restart

COMMANDS

      add    Add a service to an imp and start it (impz service add <name> <service> --cmd "…" or -- argv)
       ls    List an imp's services; a sleeping imp's as its last sleep left them                         
       rm    Stop a service and delete its file; its logs stay                                            
  restart    Stop a service and start it again from its file, so an edit applies                          

Use impz service <command> --help for more information about a command.

"
`;

exports[`it prints the help of impz service add as it always has 1`] = `
"Add a service to an imp and start it (impz service add <name> <service> --cmd "…" or -- argv) (service add)

USAGE service add [OPTIONS] <NAME> <SERVICE>

ARGUMENTS

     NAME    imp name (Required)    
  SERVICE    service name (Required)

OPTIONS

              --cmd=<cmd>    the command, run by /bin/sh                                   
              --env=<env>    KEY=VALUE; give it once per variable                          
              --cwd=<cwd>    working directory (default /)                                 
            --user=<user>    user to run as (default the image's)                          
      --restart=<restart>    always (default), on-failure or never                         
                --replace    replace a service by that name                                
  --http-port=<http_port>    then point the imp's URL at this port (impz set; needs manage)


"
`;

exports[`it prints the help of impz service ls as it always has 1`] = `
"List an imp's services; a sleeping imp's as its last sleep left them (service ls)

USAGE service ls [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz service rm as it always has 1`] = `
"Stop a service and delete its file; its logs stay (service rm)

USAGE service rm [OPTIONS] <NAME> <SERVICE>

ARGUMENTS

     NAME    imp name (Required)    
  SERVICE    service name (Required)


"
`;

exports[`it prints the help of impz service restart as it always has 1`] = `
