ARGUMENTS

        NAME    imp name (Required)              
  CHECKPOINT    checkpoint id or label (Required)

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz fork as it always has 1`] = `
"Create an imp from another imp's disk or checkpoint (impz fork v2.4.1)

USAGE impz fork [OPTIONS] <SOURCE> <NAME>

ARGUMENTS

