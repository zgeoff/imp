exports[`it prints the help of impz secret rm as it always has 1`] = `
"Delete a secret and revoke it from every imp (secret rm)

USAGE secret rm [OPTIONS] <NAME>

ARGUMENTS

  NAME    secret name (Required)


"
`;

exports[`it prints the help of impz grant as it always has 1`] = `
"Let an imp use a secret: the broker adds it to the imp's requests to its hosts (impz grant v2.4.1)

USAGE impz grant [OPTIONS] <NAME> <SECRET>

ARGUMENTS

    NAME    imp name (Required)   
  SECRET    secret name (Required)

OPTIONS

  --methods=<methods>    only requests with one of these methods get the secret, comma-separated (GET,HEAD)                
      --paths=<paths>    only requests to one of these paths get it, comma-separated; * is one segment, a last /** the rest


"
`;

exports[`it prints the help of impz revoke as it always has 1`] = `
"Take a secret away from an imp (impz revoke v2.4.1)

USAGE impz revoke [OPTIONS] <NAME> <SECRET>

ARGUMENTS

    NAME    imp name (Required)   
  SECRET    secret name (Required)


"
`;

exports[`it prints the help of impz grants as it always has 1`] = `
"List the secrets granted to an imp (impz grants v2.4.1)

USAGE impz grants [OPTIONS] <NAME>

ARGUMENTS

  NAME    imp name (Required)

OPTIONS

     --json    print JSON                                  
  --filters    show the methods and paths each grant covers


"
`;

exports[`it prints the help of impz audit as it always has 1`] = `
"Show requests the broker sent with a credential or refused, or calls to impd, newest first (impz audit v2.4.1)

USAGE impz audit [OPTIONS] [NAME]

ARGUMENTS

  NAME    imp name (default: every imp)

OPTIONS

    --kind=<kind>    broker: requests with a credential (default); refused: requests the broker refused; api: calls that changed impd
  --limit=<limit>    how many rows (default 100, at most 1000)                                                                       
           --json    print JSON                                                                                                      


"
`;

exports[`it prints the help of impz token as it always has 1`] = `
"Manage API tokens and their scopes (needs manage) (impz token v2.4.1)

USAGE impz token new|set|ls|rm|key|whoami

COMMANDS

     new    Make a token; its secret prints once, on stdout, and impd keeps only a hash                                                              
     set    Change a token's grantable secrets or its image ref prefix; its secret stays, and a secret taken off loses its grants on the token's imps
      ls    List tokens: their scopes, imps, grantable secrets and image ref prefixes, never their secrets                                           
      rm    Delete a token; its dashboard sessions, streams, sockets and ssh logins end at once                                                      
     key    Bind SSH keys to a token, list or unbind them                                                                                            
  whoami    Show who impd takes this CLI for, and what it may do                                                                                     

Use impz token <command> --help for more information about a command.

"
`;

exports[`it prints the help of impz token new as it always has 1`] = `
"Make a token; its secret prints once, on stdout, and impd keeps only a hash (token new)

USAGE token new [OPTIONS] <NAME> --scope=<scope>

ARGUMENTS

  NAME    token name (Required)

OPTIONS

                        --scope=<scope>    read, exec (read and run things in imps) or manage (everything) (Required)                                                                    
                          --imps=<imps>    limit it to these imps, such as 'dev-*' (comma-separated; default every imp)                                                                  
                --grantable=<grantable>    secrets it may grant to its imps and revoke, such as 'gh,npm' (comma-separated; needs manage and --imps)                                      
  --image-ref-prefix=<image_ref_prefix>    let it add images under its imps from refs that start with this and are pinned by digest, such as 'ghcr.io/org/app-' (needs manage and --imps)
                    --ssh-key=<ssh_key>    a public key file whose keys log in over ssh as this token                                                                                    
                                 --json    print JSON                                                                                                                                    


"
`;

exports[`it prints the help of impz token set as it always has 1`] = `
"Change a token's grantable secrets or its image ref prefix; its secret stays, and a secret taken off loses its grants on the token's imps (token set)

USAGE token set [OPTIONS] <NAME>

ARGUMENTS

  NAME    token name (Required)

OPTIONS

                --grantable=<grantable>    the whole new list, such as 'gh,npm' (comma-separated; '' for none; non-empty needs a manage token with imps)                
  --image-ref-prefix=<image_ref_prefix>    the start of the pinned refs it may add images from, such as 'ghcr.io/org/app-' ('' for none; needs a manage token with imps)
                                 --json    print JSON                                                                                                                   


"
`;

exports[`it prints the help of impz token ls as it always has 1`] = `
