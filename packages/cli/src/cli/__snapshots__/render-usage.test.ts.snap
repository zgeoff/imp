exports[`it prints the help of impz move as it always has 1`] = `
"Move an imp to another saved host: a stopped one cold, a sleeping one with its memory (see docs/guides/hosts.md) (impz move v2.4.1)

USAGE impz move [OPTIONS] <NAME> <TO>

ARGUMENTS

  NAME    imp name (Required)                
    TO    saved host to move it to (Required)

OPTIONS

    --stop    stop a running or sleeping imp first, ending its leases: a cold move
  --resume    commit a move the target verified                                   
   --abort    end a move; the imp stays here                                      


"
`;

exports[`it prints the help of impz disk as it always has 1`] = `
"Manage imp disks (impz disk v2.4.1)

USAGE impz disk resize

COMMANDS

  resize    Grow an imp's disk; the guest's filesystem grows into it (never shrinks)

Use impz disk <command> --help for more information about a command.

"
`;

exports[`it prints the help of impz disk resize as it always has 1`] = `
"Grow an imp's disk; the guest's filesystem grows into it (never shrinks) (disk resize)

USAGE disk resize [OPTIONS] <NAME> <SIZE>

ARGUMENTS

  NAME    imp name (Required)                        
  SIZE    new disk size, with a unit (64g) (Required)

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz gc as it always has 1`] = `
"Remove what a crash left that nothing names, and list the orphans it keeps (impz gc v2.4.1)

USAGE impz gc [OPTIONS] 

OPTIONS

       --dry-run    list what would go, and remove nothing                                                   
       --orphans    also retire the disks and images no row names, with their snapshots                      
  --secret-files    with --orphans, also delete the secret values impd kept aside; recover any you need first
          --json    print JSON                                                                               


"
`;

exports[`it prints the help of impz db as it always has 1`] = `
"impd's database (impz db v2.4.1)

USAGE impz db copy

COMMANDS

  copy    Copy impd's database, consistently and while it runs, under its data directory

Use impz db <command> --help for more information about a command.

"
`;

exports[`it prints the help of impz db copy as it always has 1`] = `
"Copy impd's database, consistently and while it runs, under its data directory (db copy)

USAGE db copy [OPTIONS] [NAME]

ARGUMENTS

  NAME    the copy is <data>/db-copies/<name>.sqlite (default: imp-<UTC time>)

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz backup as it always has 1`] = `
"Off-host backups of every imp (restic) (impz backup v2.4.1)

USAGE impz backup ls|run|restore|check

COMMANDS

       ls    List the backups a restore can go back to, oldest first                  
      run    Back up every imp now, as the schedule does                              
  restore    Bring an imp, or every imp, back from a backup; restored imps are stopped
    check    Read back part of the repository and verify it (restic check)            

Use impz backup <command> --help for more information about a command.

"
`;

exports[`it prints the help of impz backup ls as it always has 1`] = `
"List the backups a restore can go back to, oldest first (backup ls)

USAGE backup ls [OPTIONS] 

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz backup run as it always has 1`] = `
"Back up every imp now, as the schedule does (backup run)

USAGE backup run [OPTIONS] 

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz backup restore as it always has 1`] = `
"Bring an imp, or every imp, back from a backup; restored imps are stopped (backup restore)

USAGE backup restore [OPTIONS] [NAME]

ARGUMENTS

  NAME    the imp to restore

OPTIONS

      --all    every imp in the backup                         
  --at=<at>    the newest backup at or before this time, in UTC
  --as=<as>    the restored imp’s name, when not its own       
    --merge    with --all: add to a host that has imps already 
     --json    print JSON                                      


"
`;

exports[`it prints the help of impz backup check as it always has 1`] = `
"Read back part of the repository and verify it (restic check) (backup check)

USAGE backup check [OPTIONS] 

OPTIONS

  --subset=<subset>    how much to read: 5% (default), 1/10 or 2G


"
`;

exports[`it prints the help of impz image as it always has 1`] = `
"Manage images (impz image v2.4.1)

USAGE impz image add|build|builds|ls|rm

COMMANDS

     add    Import an image the host docker has or can pull        
   build    Build a directory with its Dockerfile into an imp image
  builds    List the image builds running now                      
      ls    List images                                            
      rm    Remove an image no imp uses                            

Use impz image <command> --help for more information about a command.

"
`;

exports[`it prints the help of impz image add as it always has 1`] = `
"Import an image the host docker has or can pull (image add)

USAGE image add [OPTIONS] <REF>

ARGUMENTS

  REF    docker image ref (Required)

OPTIONS

  --name=<name>    imp image name (defaults from the ref)
         --json    print JSON                            


"
`;

exports[`it prints the help of impz image build as it always has 1`] = `
"Build a directory with its Dockerfile into an imp image (image build)

