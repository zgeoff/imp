OPTIONS

  --name=<name>    imp image name (Required)                                              
  --file=<file>    Dockerfile path inside the context                                     
      --on-host    the directory is an absolute path on the impd host: nothing is uploaded
    -q, --quiet    print no progress and no build output, only the result or the error    
         --json    print JSON                                                             


"
`;

