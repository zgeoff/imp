exports[`it prints the help of impz secret as it always has 1`] = `
"Manage the secrets the credential broker adds (impz secret v2.4.1)

USAGE impz secret add|refresh|ls|rm

COMMANDS

      add    Store a secret in impd; the value comes from stdin or a prompt, never a flag
  refresh    Refresh an oauth secret now; exits 1 unless it is ready after it            
       ls    List secrets: their hosts and the imps they are granted to                  
       rm    Delete a secret and revoke it from every imp                                

Use impz secret <command> --help for more information about a command.

"
`;

exports[`it prints the help of impz secret add as it always has 1`] = `
"Store a secret in impd; the value comes from stdin or a prompt, never a flag (secret add)

USAGE secret add [OPTIONS] <NAME> --kind=<kind>

ARGUMENTS

  NAME    secret name (Required)

OPTIONS

                  --kind=<kind>    github, anthropic, npm, custom or oauth (both with --hosts) (Required)                                        
                --hosts=<hosts>    custom, oauth: the hosts it is for, comma-separated                                                           
              --header=<header>    custom, oauth: the header to set (default authorization)                                                      
              --scheme=<scheme>    custom, oauth: bearer (default), basic or raw                                                                 
                  --user=<user>    custom, oauth: the user name for basic                                                                        
          --upstream=<upstream>    custom, one host: send its requests here (http or https origin) instead of the host; the credential goes there
        --token-url=<token_url>    oauth: the https token endpoint                                                                               
        --client-id=<client_id>    oauth: the client the refresh token is for                                                                    
  --token-format=<token_format>    oauth: form (default) or json, the token request body                                                         
                      --replace    replace the value of a secret by that name                                                                    
                       --rebind    with --replace: let the kind or hosts change, and revoke it from every imp                                    
                         --json    print JSON                                                                                                    


"
`;

exports[`it prints the help of impz secret refresh as it always has 1`] = `
"Refresh an oauth secret now; exits 1 unless it is ready after it (secret refresh)

USAGE secret refresh [OPTIONS] <NAME>

ARGUMENTS

  NAME    secret name (Required)

OPTIONS

  --json    print JSON


"
`;

exports[`it prints the help of impz secret ls as it always has 1`] = `
"List secrets: their hosts and the imps they are granted to (secret ls)

USAGE secret ls [OPTIONS] 

OPTIONS

  --json    print JSON


"
