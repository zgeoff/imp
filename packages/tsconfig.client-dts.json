{
  "extends": "../tsconfig.base.json",
  // The published types of packages/client (its tsdown.config.ts). It sits
  // here because the dts plugin uses this file's directory as rootDir, which
  // must hold @imp/api and @imp/shared too: those packages are bundled, so
  // their declarations are emitted with the client's. No Bun globals, and the
  // DOM a browser sees.
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "types": []
  },
  "include": ["client/src", "api/src", "shared/src"],
  "exclude": ["**/*.test.ts"]
}
