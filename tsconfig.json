{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Uint8Array's base64 methods, which Bun has; the client's published types
    // stay on ES2024 (packages/tsconfig.client-dts.json)
    "lib": ["ES2024", "ESNext.TypedArrays"],
    "types": ["bun", "@zgeoff/bun-test-extended"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/client/smoke/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "deploy/**/*.ts",
    "images/**/*.ts",
    "host/**/*.ts",
    "*.test.ts"
  ],
  // a browser app with its own tsconfig (DOM, JSX)
  "exclude": ["node_modules", "tmp", "packages/dashboard"]
}
