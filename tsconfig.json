{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "@zgeoff/bun-test-extended"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/client/smoke/*.ts",
    "test/**/*.ts",
