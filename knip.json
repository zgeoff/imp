{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/oxlint-config"],
  // POSIX tools the tests run through Bun's shell
  "ignoreBinaries": ["mkfifo"],
  "workspaces": {
    ".": {
      "entry": ["test/e2e/main.ts", "test/e2e/suites/*.e2e.ts"],
      "project": [
        "test/**/*.ts",
        "scripts/**/*.ts",
        "deploy/**/*.ts",
        "images/**/*.ts",
        "host/**/*.ts",
        "*.test.ts"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/daemon": {
      // imp-docker-proxy, which host/Dockerfile compiles beside impd, the
      // suites only their own scripts run (test:pebble), and the scripts a
      // test runs in a child Bun
      "entry": ["src/docker-proxy/main.ts", "src/**/*.pebble.ts", "src/test-utils/run-*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dashboard": {
      "entry": ["augment-bun-test.ts", "e2e/*.e2e.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"]
    },
    "packages/client": {
      // the package smoke (scripts/check-client-runtimes.sh)
      "entry": ["smoke/*.ts"],
      "project": ["src/**/*.ts", "smoke/*.ts"]
    }
  }
}
