{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // protoc-gen-es is a plugin buf.gen.yaml runs
  "ignoreDependencies": [
    "@stylistic/eslint-plugin",
    "@zgeoff/oxlint-config",
    "@bufbuild/protoc-gen-es"
  ],
  // POSIX tools the tests run through Bun's shell, and the Go toolchain's
  // gofmt, which the go:fmt-vet pre-push job runs
  "ignoreBinaries": ["mkfifo", "gofmt"],
  "workspaces": {
    ".": {
      // run-related-tests.ts is a synced CLI that test:related reaches through
      // run-branch-tests.ts; its other exports serve the tests in zgeoff/tools
      "entry": [
        "e2e/main.ts",
        "e2e/suites/*.e2e.ts",
        "scripts/ci/run-related-tests.ts",
        // a protoc plugin buf.gen.yaml runs
        "scripts/proto/protoc-gen-protocol-reference.ts"
      ],
      "project": [
        "e2e/**/*.ts",
        "scripts/**/*.ts",
        "deploy/**/*.ts",
        "images/**/*.ts",
        "host/**/*.ts",
        "*.test.ts"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/daemon": {
      // imp-docker-proxy, which host/Dockerfile compiles beside impd, the
      // suites only their own scripts run (test:pebble), and the scripts a
      // test runs in a child Bun
      "entry": ["src/docker-proxy/main.ts", "src/**/*.pebble.ts", "src/test-utils/run-*.ts"],
      "project": ["src/**/*.ts"],
      // kysely-codegen and protoc-gen-es write every table and message,
      // used or not
      "ignoreIssues": {
        "src/db/schema.ts": ["types"],
        "src/agent-client/gen/**": ["exports", "types"]
      }
    },
    "packages/dashboard": {
      "entry": ["augment-bun-test.ts", "e2e/*.e2e.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"]
    },
    "packages/client": {
      // the package smoke (scripts/release/check-client-runtimes.sh)
      "entry": ["smoke/*.ts"],
      "project": ["src/**/*.ts", "smoke/*.ts"]
    }
  }
}
