{
  "services": [
    {
      "name": "web",
      "state": "backoff",
      "pid": 901,
      "restarts": 2,
      "last_exit": {
        "code": 1,
        "signal": 0
      },
      "def": {
        "name": "web",
        "argv": ["/usr/bin/web", "--port", "8080"],
        "env": ["MODE=prod"],
        "cwd": "/srv/web",
        "user": "dev",
        "restart": "on-failure",
        "source": "api"
      },
      "root": true
    }
  ],
  "image_user": "dev"
}
